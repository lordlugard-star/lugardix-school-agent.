      "parameters": {
        "descriptionType": "manual",
        "toolDescription": "Get many rows in Supabase Find a student by student_number (format like L200-DEMO-001). Returns id, name, email, whatsapp_number.",
        "operation": "getAll",
        "tableId": "students",
        "limit": 10,
        "orderBy": "name.asc",
        "filters": {
          "conditions": [
            {
              "keyName": "student_number",
              "condition": "eq",
              "keyValue": "={{ $fromAI('student_number', 'Student number, format like L200-001', 'string', 'zzz-none') }}"
            },
            {
              "keyName": "name",
              "condition": "ilike",
              "keyValue": "=*{{ $fromAI('student_name', 'Student name or part of it, e.g. amadu', 'string', 'zzz-none') }}*"
            }
          ]
        }
      },
